# HireLens - environment (SEC-9: DO NOT COMMIT REAL KEYS TO THE REPO!)
# NOTE: keep .env ASCII-only (slowapi reads it with the OS locale codec on Windows)
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://ai_hr_user:change_me_strong_password@db:5432/ai_hr_db
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# AI: Groq primary now (free tier); switch to Claude Haiku 4.5 later via AI_PROVIDER=claude
AI_PROVIDER=groq
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-haiku-4-5-20251001
JWT_SECRET=generate_a_64_char_random_hex_secret
JWT_EXPIRE_MINUTES=10080
# Суперадмин(ы) — почта аккаунта (точно как при входе), через запятую. Даёт доступ к админ-панели. Пусто = админки ни у кого нет.
SUPERADMIN_EMAILS=
ENVIRONMENT=development
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost:8000
# B4 — Google Calendar OAuth (автопланирование интервью). Оставьте пустыми, чтобы отключить интеграцию. См. GOOGLE_CALENDAR_SETUP.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# По умолчанию = {BACKEND_URL}/integrations/google/callback. Должен совпадать с Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_HTTP_TIMEOUT_SECONDS=15
# Планировщик слотов (рабочие часы Пн–Пт)
SCHEDULING_TIMEZONE=Asia/Bishkek
SCHEDULING_WORK_START_HOUR=10
SCHEDULING_WORK_END_HOUR=19
SCHEDULING_SLOT_MINUTES=30
# Порог anti-cheat (0..100): при score ≥ этого рекомендация "hire" → "maybe" + очная проверка
ANTI_CHEAT_DOWNGRADE_THRESHOLD=85
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_HR_CHAT_ID=your_chat_id
TELEGRAM_WEBHOOK_SECRET=generate_a_random_webhook_secret
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@gethirelens.tech
TELEGRAM_WEBHOOK_URL=https://your-domain/telegram/webhook
TELEGRAM_CANDIDATE_BOT_TOKEN=your_candidate_bot_token
TELEGRAM_CANDIDATE_BOT_USERNAME=your_candidate_bot_username
MAX_INTERVIEWS_PER_CANDIDATE=3
