DATABASE_URL=postgresql://postgres:472337sk@127.0.0.1:5432/ai_hr_db
# AI providers: groq = primary now (free tier), claude (Haiku 4.5) = quality option (the other serves as fallback)
# NOTE: keep this file ASCII-only (slowapi reads .env with the OS locale codec on Windows)
AI_PROVIDER=groq
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-haiku-4-5-20251001
GROQ_API_KEY=gsk_your-key-here
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080
JWT_REFRESH_EXPIRE_MINUTES=43200
FRONTEND_URL=http://localhost:3000

# Observability (prod): DSN from sentry.io, empty = disabled
SENTRY_DSN=
ENVIRONMENT=development
LOG_LEVEL=INFO
