# Скопируй в .env и заполни реальными значениями
POSTGRES_PASSWORD=strongpassword123
DATABASE_URL=postgresql://ai_hr_user:strongpassword123@db:5432/ai_hr_db
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
JWT_SECRET=change-me-to-random-64-char-string
JWT_EXPIRE_MINUTES=10080
FRONTEND_URL=http://localhost
# Telegram бот для HR уведомлений
TELEGRAM_BOT_TOKEN=
TELEGRAM_HR_CHAT_ID=
# Telegram бот для кандидатов (отдельный бот)
TELEGRAM_CANDIDATE_BOT_TOKEN=
TELEGRAM_CANDIDATE_BOT_USERNAME=
# Webhook URL для бота кандидатов (https://yourdomain.com/telegram/webhook)
TELEGRAM_WEBHOOK_URL=
